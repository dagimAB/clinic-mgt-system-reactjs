# === EXPRESS SERVER ===
PORT=3007
NODE_ENV=development

# === DATABASE (PostgreSQL) ===
# Local Development
PG_HOST=localhost
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=healthcare
PG_PORT=5432
PG_SSL=false

# Cloud Deployment Examples:
# For Render.com PostgreSQL:
# PG_HOST=your-db-name.c.neon.tech
# PG_USER=postgres
# PG_PASSWORD=your-secure-password
# PG_DATABASE=neondb
# PG_PORT=5432
# PG_SSL=true

# For AWS RDS:
# PG_HOST=your-instance.c3xxxx.us-east-1.rds.amazonaws.com
# PG_USER=postgres
# PG_PASSWORD=your-secure-password
# PG_DATABASE=healthcare
# PG_PORT=5432
# PG_SSL=true

# === JWT SECRET (Change this!) ===
KEY=your_super_secret_jwt_key_min_32_characters_long_change_this

# === AI/OPENROUTER (Optional) ===
OPENROUTER_API_KEY=sk_your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/owl-alpha

# === EMAIL NOTIFICATIONS (Optional) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_MAIL=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password

# === CORS (Optional) ===
CORS_ORIGIN=http://localhost:3000
